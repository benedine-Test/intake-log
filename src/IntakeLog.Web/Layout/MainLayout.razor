@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject SyncService Sync

<div class="wrap">
    <header class="top">
        <h1>Intake Log</h1>
        <a class="status" href="plan#sync">@StatusText</a>
    </header>

    <nav class="tabs" aria-label="Sections">
        <NavLink href="" Match="NavLinkMatch.All">Today</NavLink>
        <NavLink href="trends">Trends</NavLink>
        <NavLink href="plan">My plan</NavLink>
    </nav>

    @if (State.Loaded)
    {
        @Body
    }
    else
    {
        <p class="empty">Opening your log…</p>
    }
</div>

@code {
    private string StatusText => !State.Loaded ? "Loading…" : Sync.StatusText;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        Sync.Changed += OnChanged;
        await State.LoadAsync();
        _ = Sync.StartAsync(); // runs in the background; the log is usable straight away
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Sync.Changed -= OnChanged;
    }
}
